// XDMOD SysML v2 library: trace metadata and view metadata.
// Load it before the model files (curatrix does this: checks.yaml model.libraries).
// SPDX-License-Identifier: Apache-2.0
library package XdTrace {
    private import ScalarValues::*;

    // ------------------------------------------------------------------ need stubs (D42, D64b, D83)
    // Marks a generated stub (concern / requirement / stakeholder part) as the mirror of a
    // sphinx-needs need. Stubs are generated by `curatrix gen stubs`; nobody edits them.
    metadata def NeedRef {
        attribute needId : String;
        attribute status : String;      // draft | valid | retired
    }

    // ------------------------------------------------------------------ model elements (D129, D130, D85)
    // Trace data of a model element that becomes a need (SYS-EL, SYS-IF, SYS-UC, SYS-CFG, SYS-FEAT).
    // The need ID is the element's short name, e.g. part def <'SYS-EL-0012'> JointController.
    //   status  draft | valid | retired; generated needs take it from here (D130). Default valid.
    //   layer   context | functional | logical | product (SYS-EL only). On a package it is the
    //           default for every element inside.
    metadata def Trace {
        attribute status : String[0..1];
        attribute layer : String[0..1];
    }

    // ------------------------------------------------------------------ views (D94, views.md §3)
    // Names the view kind of a SysML `view` and its options:
    //   kind   context | usecases | decomposition | interconnection | allocation | variants
    //   root   qualified name of the element the view starts from
    //   layer  optional layer filter (functional | logical | product)
    // Views are model elements, not needs: their short name is a reserved SYS-VIEW ID.
    metadata def XdView {
        attribute kind : String;
        attribute root : String[0..1];
        attribute layer : String[0..1];
    }
}
